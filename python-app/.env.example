# Poseidon standalone Python app environment variables
# Copy this file to .env and fill in credentials for live API execution.
# Without these keys, Poseidon runs in offline/hybrid snapshot mode using data/poseidon_snapshot.json.

# Global Fishing Watch API v3 bearer token (live vessel identity, events, and track checks)
GFW_TOKEN=

# Live web search providers (Linkup primary, Tavily fallback)
LINKUP_API_KEY=
TAVILY_API_KEY=

# Databricks workspace & foundation model endpoint (e.g. https://dbc-xxxx.cloud.databricks.com)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_MODEL_ENDPOINT=databricks-llama-4-maverick

# Databricks Unity Catalog export volume path (used by POST /api/sync-databricks and Databricks Apps)
POSEIDON_VOLUME=/Volumes/workspace/poseidon/exports

# Local HTTP server port (DATABRICKS_APP_PORT takes precedence inside Databricks Apps)
PORT=8000
